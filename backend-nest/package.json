{
  "name": "safat-backend-nest",
  "version": "1.1.1",
  "description": "سرح Backend — NestJS API + Socket.IO + PostgreSQL + Redis",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:fast": "ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "test:promote-payment": "node scripts/test-promote-payment-flow.js",
    "test:ni-gateway": "node scripts/test-ni-gateway.js",
    "socket:dev": "ts-node --transpile-only -r tsconfig-paths/register src/gateway/socket.main.ts",
    "socket:start": "node dist/gateway/socket.main.js",
    "worker:dev": "ts-node --transpile-only -r tsconfig-paths/register src/queue/worker.main.ts",
    "worker:start": "node dist/queue/worker.main.js",
    "dev:all": "concurrently \"npm run start:dev\" \"npm run socket:dev\" \"npm run worker:dev\"",
    "dev:lite": "concurrently \"npm run start:dev\" \"npm run socket:dev\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --runInBand --forceExit --testTimeout=30000",
    "test:cov": "jest --runInBand --forceExit --coverage --coverageReporters=text-summary --coverageReporters=lcov --testTimeout=30000",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --forceExit --testTimeout=30000",
    "test:e2e:live": "jest --config ./test/jest-e2e.json --runInBand --forceExit --testTimeout=60000 --testPathPatterns=live",
    "ensure:e2e-admin": "ts-node -r tsconfig-paths/register scripts/ensure-e2e-admin.ts",
    "test:ci": "npm run test:cov && npm run test:e2e",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "seed:plans": "ts-node -r tsconfig-paths/register scripts/seed-plans.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.521.0",
    "@aws-sdk/s3-request-presigner": "^3.521.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.4",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/platform-socket.io": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/websockets": "^12.0.4",
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^10.63.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/multer": "^2.2.0",
    "agora-token": "^2.0.5",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.5",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "openai": "^6.46.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.10.0",
    "rate-limiter-flexible": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.7.4",
    "twilio": "^6.0.2",
    "uuid": "11.1.1",
    "zod": "^3.22.4"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^12.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.(spec|test)\\.ts$",
    "transformIgnorePatterns": [
      "/node_modules/(?!(@nestjs)/)"
    ],
    "moduleNameMapper": {
      "^@/lib/(.*)$": "<rootDir>/shared/lib/$1",
      "^@/middleware/(.*)$": "<rootDir>/shared/middleware/$1",
      "^@/butcher-applications/(.*)$": "<rootDir>/butcher-applications/$1",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "/node_modules/@nestjs/.+\\.js$": "<rootDir>/../jest-nestjs-cjs.cjs",
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "diagnostics": false
        }
      ]
    },
    "collectCoverageFrom": [
      "lib/commissions.ts",
      "lib/subscription-lifecycle.ts",
      "plans/plan.types.ts",
      "common/utils/response.util.ts",
      "common/utils/soft-delete.util.ts",
      "common/exceptions/api.exception.ts",
      "common/dto/api-response.dto.ts",
      "listings/listing-categories.ts",
      "butchers/lib/**/*.ts",
      "butchers/services/order-state-machine.service.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 70,
        "functions": 85,
        "lines": 85
      }
    },
    "testEnvironment": "node",
    "maxWorkers": 1,
    "forceExit": true
  }
}
