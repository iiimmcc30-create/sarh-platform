model ButcherOrder {
  id                 String             @id @default(uuid())
  orderNumber        String             @unique
  butcherId          String
  customerId         String
  productId          String
  cutType            String
  weightKg           Float
  reservedQuantity   Float              @default(0)
  deliveryType       String             @default("pickup")
  deliveryAddress    String?
  status             OrderStatus        @default(pending)
  paymentStatus      OrderPaymentStatus @default(unpaid)
  paidAt             DateTime?
  totalPrice         Float
  currency           String             @default("SAR")
  notes              String?
  cancelledBy        String?
  cancellationReason String?
  cancelledAt        DateTime?
  checkoutId         String?            @unique
  paymentId          String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  butcher            Butcher            @relation(fields: [butcherId], references: [id])
  customer           User               @relation(fields: [customerId], references: [id])
  product            ButcherProduct     @relation(fields: [productId], references: [id])
  checkout           ButcherCheckout?   @relation(fields: [checkoutId], references: [id])
  payment            Payment?           @relation("ButcherOrderPayment", fields: [paymentId], references: [id])
  items              ButcherOrderItem[]
  timeline           OrderTimeline[]
  audits             OrderStatusAudit[]
