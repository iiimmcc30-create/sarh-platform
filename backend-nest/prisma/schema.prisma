generator client {
  provider        = "prisma-client-js"
  /// omitApi: global omit of Listing.lat/lng (never serialized to API clients).
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                  String                            @id @default(uuid())
  username                            String                            @unique
  email                               String?                           @unique
  phone                               String?                           @unique
  googleId                            String?                           @unique
  passwordHash                        String
  passwordVersion                     Int                               @default(0)
  emailVerified                       Boolean                           @default(false)
  displayName                         String
  arabicName                          String
  avatar                              String?
  coverImage                          String?
  bio                                 String?
  about                               String?
  website                             String?
  /// Profile links under the bio: JSON array of { url, label? } (max 3). NULL = never set.
  profileLinks                        Json?
  publicPhone                         String?
  publicEmail                         String?
  verified                            Boolean                           @default(false)
  /// Badge tier: "blue" | "blue_plus" | "gold" (only "gold" is the gold badge;
  /// blue_plus and null = legacy verified render the blue badge).
  verifiedTier                        String?
  /// True when `verified` was granted by an active verification subscription
  /// (so it is revoked when the subscription ends). Legacy badges stay false.
  subscriptionBadge                   Boolean                           @default(false)
  /// Subscriber preference: hide the verification badge from other users
  /// (ranking / visibility perks stay). Applied to API responses only.
  hideVerifiedBadge                   Boolean                           @default(false)
  /// Gold subscriber preference: hide the «بائع ذهبي» label from others.
  hideGoldSellerLabel                 Boolean                           @default(false)
  isAI                                Boolean                           @default(false)
  country                             Country                           @default(SA)
  role                                Role                              @default(USER)
  isActive                            Boolean                           @default(true)
  lastSeenAt                          DateTime?
  fcmToken                            String?
  rating                              Float                             @default(0)
  reviewCount                         Int                               @default(0)
  showInSearch                        Boolean                           @default(true)
  allowPrivateMessages                Boolean                           @default(true)
  showFollowingList                   Boolean                           @default(true)
  birthDate                           DateTime?
  commentsAudience                    String                            @default("everyone")
  privateMessagesAudience             String                            @default("everyone")
  notificationsEnabled                Boolean                           @default(true)
  /// Per-type push preferences: JSON object { messages, follows, interactions,
  /// followingPosts, councils, offers } of booleans. NULL / missing key = on.
  notificationPrefs                   Json?
  createdAt                           DateTime                          @default(now())
  updatedAt                           DateTime                          @updatedAt
  nameChangedAt                       DateTime?
  usernameChangedAt                   DateTime?
  deletedAt                           DateTime?
  activities                          Activity[]                        @relation("ActivityActor")
  activityTargets                     Activity[]                        @relation("ActivityTarget")
  reviewsReceived                     UserReview[]                      @relation("UserReviewsReceived")
  reviewsGiven                        UserReview[]                      @relation("UserReviewsGiven")
  following                           Follow[]                          @relation("Followers")
  followers                           Follow[]                          @relation("Following")
  blocksInitiated                     UserBlock[]                       @relation("BlocksInitiated")
  blocksReceived                      UserBlock[]                       @relation("BlocksReceived")
  listings                            Listing[]
  fees                                ListingFee[]
  listingBoosts                       ListingBoost[]
  listingPromotions                   ListingPromotion[]
  liveStreams                         LiveStream[]
  receivedMessages                    Message[]                         @relation("ReceivedMessages")
  sentMessages                        Message[]                         @relation("SentMessages")
  notifications                       Notification[]
  payments                            Payment[]
  storePurchases                      StorePurchase[]
  posts                               Post[]
  postComments                        PostComment[]
  listingComments                     ListingComment[]
  postLikes                           PostLike[]
  postReposts                         PostRepost[]
  postBookmarks                       PostBookmark[]
  stories                             Story[]
  storyViews                          StoryView[]
  storyReactions                      StoryReaction[]
  subscription                        Subscription?
  sessions                            UserSession[]
  supportTickets                      SupportTicket[]
  assignedSupportTickets              SupportTicket[]                   @relation("TicketAssignee")
  supportTicketMessages               SupportTicketMessage[]
  accountVerificationRequest          AccountVerificationRequest?
  reviewedVerificationRequests        AccountVerificationRequest[]      @relation("VerificationReviewer")
  accountActionsReceived              AdminAccountAction[]              @relation("AccountActionTarget")
  accountActionsTaken                 AdminAccountAction[]              @relation("AccountActionActor")
  deviceTokens                        UserDeviceToken[]
  adminTwoFactor                      AdminTwoFactor?
  messageThreadStates                 MessageThreadState[]
  collectionsOwned                    Collection[]                      @relation("CollectionOwner")
  collectionMemberships               CollectionMember[]
  collectionFollows                   CollectionFollower[]
  collectionBlocks                    CollectionBlock[]
  councilsOwned                       Council[]                         @relation("CouncilOwner")
  councilMemberships                  CouncilMember[]                   @relation("CouncilMemberUser")
  councilSpeakRequests                CouncilSpeakRequest[]             @relation("CouncilSpeakRequestUser")
  councilInvites                      CouncilInvite[]                   @relation("CouncilInviteUser")
  councilReminders                    CouncilReminder[]                 @relation("CouncilReminderUser")
  profileViewsReceived                ProfileView[]                     @relation("ProfileViewsReceived")
  profileViewsGiven                   ProfileView[]                     @relation("ProfileViewsGiven")
  mutesInitiated                      UserMute[]                        @relation("MutesInitiated")
  mutesReceived                       UserMute[]                        @relation("MutesReceived")
  consentRecords                      ConsentRecord[]

  @@index([username])
  @@index([email])
  @@index([country])
  @@index([isActive])
  @@index([deletedAt])
}

/// `refreshToken` stores the SHA-256 hex of the refresh JWT (legacy rows: the
/// raw JWT until their next rotation). `previousTokenHash` + `rotatedAt` keep the
/// token the last rotation replaced so a replay inside 30s (lost response,
/// concurrent refresh) is not treated as theft.
model UserSession {
  id                String    @id @default(uuid())
  userId            String
  refreshToken      String    @unique
  previousTokenHash String?
  rotatedAt         DateTime?
  deviceInfo        String?
  ipAddress         String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([previousTokenHash])
}

/// Optional TOTP 2FA for admin-panel staff (ADMIN / MODERATOR).
/// `secretSealed` is AES-256-GCM (ADMIN_TOTP_ENC_KEY, else JWT_SECRET-derived).
/// `enabledAt` null = enrolment started but not confirmed yet.
model AdminTwoFactor {
  userId       String    @id
  secretSealed String
  enabledAt    DateTime?
  lastUsedStep Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

/// «مين شاف ملفي»: one row per viewer per profile per day (latest view time).
model ProfileView {
  id        String   @id @default(uuid())
  profileId String
  viewerId  String
  /// UTC day of the view (dedupe key).
  day       DateTime @db.Date
  viewedAt  DateTime @default(now())
  profile   User     @relation("ProfileViewsReceived", fields: [profileId], references: [id], onDelete: Cascade)
  viewer    User     @relation("ProfileViewsGiven", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([profileId, viewerId, day])
  @@index([profileId, viewedAt])
  @@index([viewerId])
}

/// Muted account: the muter no longer sees the muted user's posts or stories in
/// feeds. Silent and one-way (unlike a block, nothing changes for the muted user).
model UserMute {
  id        String   @id @default(uuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())
  muter     User     @relation("MutesInitiated", fields: [muterId], references: [id], onDelete: Cascade)
  muted     User     @relation("MutesReceived", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([muterId])
  @@index([mutedId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

/// «المجموعات»: a user-curated collection whose feed is built live from its
/// members' own posts (type POSTS) or listings (type ADS). Nothing is copied.
model Collection {
  id          String               @id @default(uuid())
  ownerId     String
  name        String
  description String?
  coverUrl    String?
  type        CollectionType
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  owner       User                 @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     CollectionMember[]
  followers   CollectionFollower[]
  blocks      CollectionBlock[]

  @@index([ownerId])
  @@index([name])
  @@index([createdAt])
}

/// Accounts whose content feeds the collection (added by the owner, no approval).
model CollectionMember {
  id           String     @id @default(uuid())
  collectionId String
  userId       String
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([userId])
}

/// Users who follow the collection to read its feed (independent from membership).
model CollectionFollower {
  id           String     @id @default(uuid())
  collectionId String
  userId       String
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([userId])
}

/// Per-user hide («حظر المجموعة»), same shape as UserBlock.
model CollectionBlock {
  id           String     @id @default(uuid())
  collectionId String
  userId       String
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([userId])
}

enum CollectionType {
  POSTS
  ADS
}

/// «المجالس»: audio-only rooms (no video, no feed) on the shared Agora stack.
/// At most 12 members are on stage at once: enforced in a transaction that locks
/// the council row (SELECT ... FOR UPDATE), backed by @@unique([councilId, seatIndex])
/// and a CHECK (seatIndex BETWEEN 0 AND 11) added in the migration SQL.
model Council {
  id                   String                @id @default(uuid())
  ownerId              String
  name                 String
  description          String?
  /// Ordered «قواعد المجلس», shown before joining.
  rules                String[]              @default([])
  visibility           CouncilVisibility     @default(PUBLIC)
  status               CouncilStatus         @default(LIVE)
  agoraChannelName     String                @unique
  /// Private councils: invite link code (rotatable by the owner).
  inviteCode           String                @unique
  /// Moderator powers granted by the owner (per council).
  modCanManageRequests Boolean               @default(true)
  modCanMute           Boolean               @default(true)
  modCanRemove         Boolean               @default(true)
  modCanBan            Boolean               @default(false)
  /// Gold hosts: only the host's followers (plus the host and invited users) may join.
  followersOnly        Boolean               @default(false)
  /// Scheduled councils (status SCHEDULED): planned start time (Blue+ / Gold hosts).
  scheduledFor         DateTime?
  /// When «ذكّرني» users were notified that the council started (sent once).
  remindersSentAt      DateTime?
  hostLastSeenAt       DateTime              @default(now())
  /// «عرض صورة» (Gold): image pinned at the top of the room; null = none. Late joiners
  /// read it from here, live members get `council:image`.
  imageUrl             String?
  /// Set when the image came from one of the poster's listings («عرض الإعلان»).
  imageListingId       String?
  imageById            String?
  imageAt              DateTime?
  createdAt            DateTime              @default(now())
  startedAt            DateTime              @default(now())
  endedAt              DateTime?
  updatedAt            DateTime              @updatedAt
  owner                User                  @relation("CouncilOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members              CouncilMember[]
  speakRequests        CouncilSpeakRequest[]
  invites              CouncilInvite[]
  reminders            CouncilReminder[]

  @@index([ownerId, status])
  @@index([status, visibility, startedAt])
  @@index([status, scheduledFor])
}

/// One row per user who joined (or was banned from) a council. "On stage" = seatIndex set.
model CouncilMember {
  id               String            @id @default(uuid())
  councilId        String
  userId           String
  role             CouncilMemberRole @default(LISTENER)
  seatIndex        Int?
  micMuted         Boolean           @default(true)
  /// Hard mute by the host/moderator: the speaker cannot unmute and gets no publish token.
  mutedByModerator Boolean           @default(false)
  rulesAcceptedAt  DateTime?
  kickedUntil      DateTime?
  bannedAt         DateTime?
  bannedById       String?
  joinedAt         DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  council          Council           @relation(fields: [councilId], references: [id], onDelete: Cascade)
  user             User              @relation("CouncilMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([councilId, userId])
  @@unique([councilId, seatIndex])
  @@index([userId])
  @@index([councilId, role])
}

model CouncilSpeakRequest {
  id          String                    @id @default(uuid())
  councilId   String
  userId      String
  status      CouncilSpeakRequestStatus @default(PENDING)
  decidedById String?
  createdAt   DateTime                  @default(now())
  decidedAt   DateTime?
  council     Council                   @relation(fields: [councilId], references: [id], onDelete: Cascade)
  user        User                      @relation("CouncilSpeakRequestUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([councilId, status, createdAt])
  @@index([userId])
}

/// Private councils: users invited by the owner/moderators.
model CouncilInvite {
  id          String   @id @default(uuid())
  councilId   String
  userId      String
  invitedById String
  createdAt   DateTime @default(now())
  council     Council  @relation(fields: [councilId], references: [id], onDelete: Cascade)
  user        User     @relation("CouncilInviteUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([councilId, userId])
  @@index([userId])
}

/// «ذكّرني» on a scheduled council: notified once when it starts.
model CouncilReminder {
  id        String   @id @default(uuid())
  councilId String
  userId    String
  createdAt DateTime @default(now())
  council   Council  @relation(fields: [councilId], references: [id], onDelete: Cascade)
  user      User     @relation("CouncilReminderUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([councilId, userId])
  @@index([userId])
}

enum CouncilVisibility {
  PUBLIC
  PRIVATE
}

enum CouncilStatus {
  LIVE
  ENDED
  SCHEDULED
}

enum CouncilMemberRole {
  OWNER
  MODERATOR
  SPEAKER
  LISTENER
  BANNED
}

enum CouncilSpeakRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model Plan {
  id             String         @id @default(uuid())
  slug           String
  name           String
  description    String         @default("")
  audience       PlanAudience
  monthlyPrice   Float          @default(0)
  yearlyPrice    Float          @default(0)
  currency       String         @default("SAR")
  yearlyDiscount Float          @default(0)
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  features       PlanFeature[]
  subscriptions  Subscription[]

  @@unique([slug, audience])
  @@index([audience, isActive, sortOrder])
}

model PlanFeature {
  id        String           @id @default(uuid())
  planId    String
  key       String
  value     String
  valueType FeatureValueType
  plan      Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId])
}

model Subscription {
  id                  String       @id @default(uuid())
  userId              String       @unique
  planId              String       @default("free")
  planAudience        PlanAudience @default(USER)
  planDbId            String?
  billingCycle        String       @default("monthly")
  status              String       @default("active")
  renewDate           DateTime
  listingsUsed        Int          @default(0)
  liveMinutesUsed     Int          @default(0)
  featuredAdsUsed     Int          @default(0)
  pinnedAdsUsed       Int          @default(0)
  dailyAdsUsed        Int          @default(0)
  dailyAdsWindowStart DateTime?
  autoRenew           Boolean      @default(true)
  /// Free Blue+ trial (one per account, ever). Set once when the user starts
  /// the trial and never cleared, so the account can never start another one.
  /// While the trial runs `status` is "trial" (a payment sets it back to
  /// "active").
  trialStartedAt      DateTime?
  /// End of the free trial (equals `renewDate` of the trial period).
  trialEndsAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  payments            Payment[]
  plan                Plan?        @relation(fields: [planDbId], references: [id])
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([planDbId])
}

model Payment {
  id             String                @id @default(uuid())
  userId         String
  subscriptionId String?
  feeId          String?
  referenceId    String?
  referenceType  PaymentReferenceType?
  orderId        String                @unique
  amount         Float
  currency       String                @default("SAR")
  method         PaymentMethod
  status         PaymentStatus         @default(pending)
  transactionId  String?
  checkoutUrl    String?
  description    String?
  descriptionAr  String?
  metadata       Json?
  paidAt         DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  fee               ListingFee?        @relation(fields: [feeId], references: [id])
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  integrationOrder  IntegrationOrder?

  @@index([userId])
  @@index([status])
  @@index([orderId])
  @@index([transactionId])
  @@index([userId, referenceId, referenceType, status])
}

/// Apple In-App Purchase / Google Play Billing transactions for digital
/// services sold inside the native apps (verification subscriptions, boosts,
/// promotion). One row per store transaction: Apple transactionId, Google
/// orderId. The unique key makes verification and webhooks idempotent.
model StorePurchase {
  id                    String              @id @default(uuid())
  platform              StorePlatform
  productId             String
  /// subscription | boost | promotion (store-purchases/store-products.ts).
  productKind           String
  transactionId         String
  originalTransactionId String?
  /// Google purchase token (the Apple JWS is kept in raw).
  purchaseToken         String?
  userId                String
  status                StorePurchaseStatus @default(processing)
  autoRenew             Boolean?
  /// Production | Sandbox (Apple) / production | test (Google).
  environment           String?
  listingId             String?
  paymentId             String?             @unique
  purchasedAt           DateTime?
  expiresAt             DateTime?
  revokedAt             DateTime?
  lastError             String?
  raw                   Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, transactionId])
  @@index([userId])
  @@index([originalTransactionId])
  @@index([purchaseToken])
  @@index([status])
}

/// Processed App Store Server Notifications V2 / Google RTDN messages
/// (dedupe by notificationUUID / Pub/Sub messageId).
model StoreNotification {
  id             String        @id @default(uuid())
  platform       StorePlatform
  notificationId String
  type           String
  subtype        String?
  transactionId  String?
  outcome        String?
  createdAt      DateTime      @default(now())

  @@unique([platform, notificationId])
  @@index([transactionId])
}

enum StorePlatform {
  app_store
  google_play
}

enum StorePurchaseStatus {
  /// Row claimed, entitlement being granted.
  processing
  /// Entitlement granted (subscription active / boost applied).
  active
  /// Subscription period ended (not renewed).
  expired
  /// Refunded or revoked by the store.
  revoked
  /// Verification or granting failed; may be retried.
  failed
}

/// External provider checkout (currently Network International / N-Genius).
/// Local Payment.orderId stays the Sarh merchant reference; externalOrderId is the NI UUID.
model IntegrationOrder {
  id                       String               @id @default(uuid())
  paymentId                String               @unique
  provider                 IntegrationProvider  @default(ni)
  status                   IntegrationStatus    @default(pending)
  merchantOrderReference   String
  idempotencyKey           String               @unique
  externalOrderId          String?
  externalReference        String?
  checkoutUrl              String?
  requestPayload           Json?
  responsePayload          Json?
  lastError                String?
  retryCount               Int                  @default(0)
  lastAttemptAt            DateTime?
  syncedAt                 DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  payment                  Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([provider, status])
  @@index([externalOrderId])
  @@index([merchantOrderReference])
}

model IntegrationWebhookEvent {
  id         String              @id @default(uuid())
  provider   IntegrationProvider
  eventKey   String
  eventName  String?
  payload    Json
  processed  Boolean             @default(false)
  paymentId  String?
  lastError  String?
  createdAt  DateTime            @default(now())

  @@unique([provider, eventKey])
  @@index([paymentId])
  @@index([createdAt])
}

model MarketCategory {
  id                    String           @id @default(uuid())
  nameAr                String
  nameEn                String?
  slug                  String           @unique
  icon                  String?
  emoji                 String?
  parentId              String?
  sortOrder             Int              @default(0)
  isActive              Boolean          @default(true)
  requiresWeight        Boolean          @default(false)
  legacyCategory        String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?
  parent                MarketCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children              MarketCategory[] @relation("CategoryTree")
  listingsAsCategory    Listing[]        @relation("ListingMarketCategory")
  listingsAsSubcategory Listing[]        @relation("ListingMarketSubcategory")

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model Listing {
  id                String          @id @default(uuid())
  /// Null only for ADMIN_MANAGED listings. Real listings always have a user.
  sellerId          String?
  origin            ListingOrigin   @default(USER)
  /// Display-only identity. Never a User login, id, or foreign key.
  displayUsername   String?
  displaySellerName String?
  displayPhone      String?
  displayRegion     String?
  title             String
  arabicTitle       String
  description       String
  arabicDescription String
  price             Float
  currency          String          @default("SAR")
  category          ListingCategory
  categoryId        String?
  subcategoryId     String?
  breed             String?
  age               String?
  quantity          Int             @default(1)
  location          String
  arabicLocation    String
  country           Country
  contactPhone      String?
  weightKg          Float?
  images            String[]
  videoUrl          String?
  thumbnailUrl      String?
  videoDuration     Float?
  videoWidth        Int?
  videoHeight       Int?
  videoFileSize     Int?
  featured          Boolean         @default(false)
  pinned            Boolean         @default(false)
  featuredUntil     DateTime?
  pinnedUntil       DateTime?
  promoted          Boolean         @default(false)
  promotedUntil     DateTime?
  promotionWeight   Int             @default(0)
  promotionTier     String?
  status            ListingStatus   @default(active)
  views             Int             @default(0)
  commentsCount     Int             @default(0)
  editCount         Int             @default(0)
  expiresAt         DateTime?
  covenantAccepted    Boolean   @default(false)
  covenantAcceptedAt  DateTime?
  covenantVersion     String?
  sellerDeclaredSold  Boolean?
  sellerDeclaredSoldAt DateTime?
  deleteReason        String?
  /// Approximate point for «القريب منك»: city centre (CITY) or GPS rounded to ~1 km (GPS).
  /// Never returned by the API (omitted globally in PrismaService).
  lat               Float?
  lng               Float?
  cityId            String?
  geoSource         ListingGeoSource?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  seller            User?           @relation(fields: [sellerId], references: [id])
  city              SaudiCity?      @relation(fields: [cityId], references: [id], onDelete: SetNull)
  marketCategory    MarketCategory? @relation("ListingMarketCategory", fields: [categoryId], references: [id])
  marketSubcategory MarketCategory? @relation("ListingMarketSubcategory", fields: [subcategoryId], references: [id])
  fee               ListingFee?
  boosts            ListingBoost[]
  promotions        ListingPromotion[]
  offers            ListingOffer[]
  stories           Story[]
  comments          ListingComment[]

  @@index([sellerId])
  @@index([origin])
  @@index([category])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([country])
  @@index([status])
  @@index([featured])
  @@index([pinned])
  @@index([promoted])
  @@index([promotionWeight])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@index([lat, lng])
  @@index([cityId])
}

enum ListingGeoSource {
  CITY
  GPS
}

/// Saudi cities / governorates / centres with centre coordinates (seeded from
/// assets/geo/saudi-cities.json). Used for «القريب منك» and the city picker.
model SaudiCity {
  id        String    @id
  regionId  String
  nameAr    String
  nameEn    String
  aliases   String[]
  lat       Float
  lng       Float
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  listings  Listing[]

  @@index([regionId])
}

model ListingBoost {
  id            String     @id @default(uuid())
  listingId     String
  userId        String
  boostType     BoostType
  durationDays  Int        @default(30)
  amount        Float
  currency      String     @default("SAR")
  status        FeeStatus  @default(pending)
  startsAt      DateTime?
  expiresAt     DateTime?
  transactionId String?
  paidAt        DateTime?
  paymentId     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  listing       Listing    @relation(fields: [listingId], references: [id])
  user          User       @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model ListingPromotion {
  id              String    @id @default(uuid())
  listingId       String
  userId          String
  tier            String    @default("standard")
  weight          Int       @default(100)
  durationDays    Int
  amount          Float
  currency        String    @default("SAR")
  status          FeeStatus @default(pending)
  startsAt        DateTime?
  expiresAt       DateTime?
  transactionId   String?
  paidAt          DateTime?
  paymentId       String?
  impressions     Int       @default(0)
  clicks          Int       @default(0)
  promotedViews   Int       @default(0)
  baselineViews   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  listing         Listing   @relation(fields: [listingId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([tier])
}

model ListingFee {
  id            String    @id @default(uuid())
  listingId     String    @unique
  userId        String
  category      String
  quantity      Int       @default(1)
  price         Float
  commission    Float
  status        FeeStatus @default(pending)
  dueDate       DateTime?
  saleAmount    Float?
  saleDeclaredAt DateTime?
  paidAt        DateTime?
  transactionId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  listing       Listing   @relation(fields: [listingId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  payments      Payment[]

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate])
}

model AdminAccountAction {
  id        String   @id @default(uuid())
  userId    String
  actorId   String
  action    String
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation("AccountActionTarget", fields: [userId], references: [id], onDelete: Cascade)
  actor     User     @relation("AccountActionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([actorId])
}

model ListingOffer {
  id        String   @id @default(uuid())
  listingId String
  buyerId   String
  amount    Float
  currency  String   @default("SAR")
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId])
}

model Post {
  id               String            @id @default(uuid())
  authorId         String
  content          String
  arabicContent    String
  image            String?
  images           String[]          @default([])
  isHidden         Boolean           @default(false)
  likesCount       Int               @default(0)
  repostsCount     Int               @default(0)
  commentsCount    Int               @default(0)
  viewsCount       Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  author           User              @relation(fields: [authorId], references: [id])
  comments         PostComment[]
  likes            PostLike[]
  reposts          PostRepost[]
  bookmarks        PostBookmark[]
  media            PostMedia[]
  knowledgeArticle KnowledgeArticle?

  @@index([authorId])
  @@index([createdAt])
  @@index([deletedAt])
}

model PostMedia {
  id        String        @id @default(uuid())
  postId    String
  url       String
  type      PostMediaType
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostRepost {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostBookmark {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model ListingComment {
  id        String           @id @default(uuid())
  listingId String
  authorId  String
  content   String
  createdAt DateTime         @default(now())
  /// Reply target (one level: replies always point at a top-level comment). NULL = top-level.
  parentId  String?
  author    User             @relation(fields: [authorId], references: [id])
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  parent    ListingComment?  @relation("ListingCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ListingComment[] @relation("ListingCommentReplies")

  @@index([listingId])
  @@index([parentId])
}

model Story {
  id             String          @id @default(uuid())
  userId         String
  thumbnail      String
  mediaUrl       String?
  caption        String?
  captionAr      String?
  location       String?
  duration       Int             @default(5)
  isLive         Boolean         @default(false)
  liveStreamId   String?
  listingId      String?
  viewsCount     Int             @default(0)
  reactionsCount Int             @default(0)
  expiresAt      DateTime
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing        Listing?        @relation(fields: [listingId], references: [id], onDelete: SetNull)
  views          StoryView[]
  reactions      StoryReaction[]

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt, createdAt])
  @@index([expiresAt, createdAt])
  @@index([listingId])
  @@index([deletedAt])
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  viewerId  String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([storyId, createdAt])
  @@index([viewerId])
}

model StoryReaction {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId])
}

model LiveStream {
  id          String        @id @default(uuid())
  hostId      String
  title       String
  arabicTitle String
  thumbnail   String?
  category    String
  topic       String?
  streamKey   String        @unique @default(uuid())
  rtmpUrl     String?
  hlsUrl      String?
  isLive      Boolean       @default(false)
  viewers     Int           @default(0)
  peakViewers Int           @default(0)
  likes       Int           @default(0)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?
  comments    LiveComment[]
  host        User          @relation(fields: [hostId], references: [id])

  @@index([hostId])
  @@index([isLive])
  @@index([deletedAt])
}

model LiveComment {
  id          String     @id @default(uuid())
  streamId    String
  userId      String?
  username    String
  arabicName  String?
  message     String
  avatar      String?
  isOffer     Boolean    @default(false)
  offerAmount Float?
  createdAt   DateTime   @default(now())
  stream      LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([streamId, createdAt])
}

model Message {
  id         String        @id @default(uuid())
  threadId   String
  senderId   String
  receiverId String
  text       String?
  imageUrl   String?
  videoUrl   String?
  /// Content kind. Legacy rows default to TEXT; renderers still infer image/video from the URL columns.
  type            MessageContentType @default(TEXT)
  audioUrl        String?
  mediaDurationMs Int?
  mediaMimeType   String?
  mediaSizeBytes  Int?
  isRead     Boolean       @default(false)
  readAt     DateTime?
  createdAt  DateTime      @default(now())
  receiver   User          @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User          @relation("SentMessages", fields: [senderId], references: [id])
  thread     MessageThread @relation(fields: [threadId], references: [id])

  @@index([threadId])
  @@index([senderId])
  @@index([receiverId])
  @@index([threadId, createdAt])
}

model MessageThread {
  id            String            @id @default(uuid())
  participant1  String
  participant2  String
  type          MessageThreadType @default(DIRECT)
  /// Unique conversation scope ("direct").
  scopeKey      String            @default("direct")
  lastMessageAt DateTime          @default(now())
  createdAt     DateTime          @default(now())
  messages      Message[]
  states        MessageThreadState[]

  @@unique([participant1, participant2, scopeKey])
  @@index([participant1])
  @@index([participant2])
  @@index([lastMessageAt])
  @@index([type])
}

model MessageThreadState {
  id       String         @id @default(uuid())
  threadId String
  userId   String
  pinnedAt DateTime?
  hiddenAt DateTime?
  /// Per-participant mute: messages are still stored/delivered, push is skipped.
  mutedAt  DateTime?
  thread   MessageThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@index([threadId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  titleAr   String
  bodyAr    String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model Activity {
  id           String   @id @default(uuid())
  actorId      String
  targetUserId String?
  type         String
  entityId     String?
  entityType   String?
  createdAt    DateTime @default(now())
  actor        User     @relation("ActivityActor", fields: [actorId], references: [id])
  target       User?    @relation("ActivityTarget", fields: [targetUserId], references: [id])

  @@index([actorId])
  @@index([targetUserId])
}

// General account rating — any user can rate any other user's account once (editable).
model UserReview {
  id         String   @id @default(uuid())
  targetId   String
  reviewerId String
  rating     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  target     User     @relation("UserReviewsReceived", fields: [targetId], references: [id])
  reviewer   User     @relation("UserReviewsGiven", fields: [reviewerId], references: [id])

  @@unique([targetId, reviewerId])
  @@index([targetId])
  @@index([reviewerId])
}

