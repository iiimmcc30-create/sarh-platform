generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                  String                            @id @default(uuid())
  username                            String                            @unique
  email                               String?                           @unique
  phone                               String?                           @unique
  googleId                            String?                           @unique
  passwordHash                        String
  passwordVersion                     Int                               @default(0)
  emailVerified                       Boolean                           @default(false)
  displayName                         String
  arabicName                          String
  avatar                              String?
  coverImage                          String?
  bio                                 String?
  about                               String?
  website                             String?
  publicPhone                         String?
  publicEmail                         String?
  verified                            Boolean                           @default(false)
  isAI                                Boolean                           @default(false)
  country                             Country                           @default(SA)
  role                                Role                              @default(USER)
  isActive                            Boolean                           @default(true)
  lastSeenAt                          DateTime?
  fcmToken                            String?
  rating                              Float                             @default(0)
  reviewCount                         Int                               @default(0)
  showInSearch                        Boolean                           @default(true)
  allowPrivateMessages                Boolean                           @default(true)
  showFollowingList                   Boolean                           @default(true)
  birthDate                           DateTime?
  commentsAudience                    String                            @default("everyone")
  privateMessagesAudience             String                            @default("everyone")
  notificationsEnabled                Boolean                           @default(true)
  createdAt                           DateTime                          @default(now())
  updatedAt                           DateTime                          @updatedAt
  nameChangedAt                       DateTime?
  usernameChangedAt                   DateTime?
  deletedAt                           DateTime?
  activities                          Activity[]                        @relation("ActivityActor")
  activityTargets                     Activity[]                        @relation("ActivityTarget")
  reviewsReceived                     UserReview[]                      @relation("UserReviewsReceived")
  reviewsGiven                        UserReview[]                      @relation("UserReviewsGiven")
  butcherProfile                      Butcher?
  butcherOrders                       ButcherOrder[]
  butcherCheckouts                    ButcherCheckout[]
  butcherCheckoutReservations         ButcherCheckoutReservation[]
  following                           Follow[]                          @relation("Followers")
  followers                           Follow[]                          @relation("Following")
  blocksInitiated                     UserBlock[]                       @relation("BlocksInitiated")
  blocksReceived                      UserBlock[]                       @relation("BlocksReceived")
  listings                            Listing[]
  fees                                ListingFee[]
  listingBoosts                       ListingBoost[]
  listingPromotions                   ListingPromotion[]
  liveStreams                         LiveStream[]
  receivedMessages                    Message[]                         @relation("ReceivedMessages")
  sentMessages                        Message[]                         @relation("SentMessages")
  notifications                       Notification[]
  payments                            Payment[]
  posts                               Post[]
  postComments                        PostComment[]
  listingComments                     ListingComment[]
  postLikes                           PostLike[]
  postReposts                         PostRepost[]
  postBookmarks                       PostBookmark[]
  stories                             Story[]
  storyViews                          StoryView[]
  storyReactions                      StoryReaction[]
  subscription                        Subscription?
  sessions                            UserSession[]
  butcherReviews                      ButcherReview[]
  butcherFavorites                    ButcherFavorite[]
  butcherApplications                 ButcherApplication[]
  butcherApplicationTimelineEvents    ButcherApplicationTimelineEvent[]
  verifiedButcherApplicationDocuments ButcherApplicationDocument[]      @relation("DocumentVerifiedBy")
  supportTickets                      SupportTicket[]
  assignedSupportTickets              SupportTicket[]                   @relation("TicketAssignee")
  supportTicketMessages               SupportTicketMessage[]
  accountVerificationRequest          AccountVerificationRequest?
  reviewedVerificationRequests        AccountVerificationRequest[]      @relation("VerificationReviewer")
  accountActionsReceived              AdminAccountAction[]              @relation("AccountActionTarget")
  accountActionsTaken                 AdminAccountAction[]              @relation("AccountActionActor")
  deviceTokens                        UserDeviceToken[]
  messageThreadStates                 MessageThreadState[]

  @@index([username])
  @@index([email])
  @@index([country])
  @@index([isActive])
  @@index([deletedAt])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserDeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Plan {
  id             String         @id @default(uuid())
  slug           String
  name           String
  description    String         @default("")
  audience       PlanAudience
  monthlyPrice   Float          @default(0)
  yearlyPrice    Float          @default(0)
  currency       String         @default("SAR")
  yearlyDiscount Float          @default(0)
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  features       PlanFeature[]
  subscriptions  Subscription[]

  @@unique([slug, audience])
  @@index([audience, isActive, sortOrder])
}

model PlanFeature {
  id        String           @id @default(uuid())
  planId    String
  key       String
  value     String
  valueType FeatureValueType
  plan      Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId])
}

model Subscription {
  id                  String       @id @default(uuid())
  userId              String       @unique
  planId              String       @default("free")
  planAudience        PlanAudience @default(USER)
  planDbId            String?
  billingCycle        String       @default("monthly")
  status              String       @default("active")
  renewDate           DateTime
  listingsUsed        Int          @default(0)
  liveMinutesUsed     Int          @default(0)
  featuredAdsUsed     Int          @default(0)
  pinnedAdsUsed       Int          @default(0)
  dailyAdsUsed        Int          @default(0)
  dailyAdsWindowStart DateTime?
  autoRenew           Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  payments            Payment[]
  plan                Plan?        @relation(fields: [planDbId], references: [id])
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([planDbId])
}

model Payment {
  id             String                @id @default(uuid())
  userId         String
  subscriptionId String?
  feeId          String?
  referenceId    String?
  referenceType  PaymentReferenceType?
  orderId        String                @unique
  amount         Float
  currency       String                @default("SAR")
  method         PaymentMethod
  status         PaymentStatus         @default(pending)
  transactionId  String?
  checkoutUrl    String?
  description    String?
  descriptionAr  String?
  metadata       Json?
  paidAt         DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  fee               ListingFee?        @relation(fields: [feeId], references: [id])
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  integrationOrder  IntegrationOrder?
  butcherCheckout   ButcherCheckout?
  butcherOrder      ButcherOrder?      @relation("ButcherOrderPayment")

  @@index([userId])
  @@index([status])
  @@index([orderId])
  @@index([transactionId])
  @@index([userId, referenceId, referenceType, status])
}

/// External provider checkout (currently Network International / N-Genius).
/// Local Payment.orderId stays the Sarh merchant reference; externalOrderId is the NI UUID.
model IntegrationOrder {
  id                       String               @id @default(uuid())
  paymentId                String               @unique
  provider                 IntegrationProvider  @default(ni)
  status                   IntegrationStatus    @default(pending)
  merchantOrderReference   String
  idempotencyKey           String               @unique
  externalOrderId          String?
  externalReference        String?
  checkoutUrl              String?
  requestPayload           Json?
  responsePayload          Json?
  lastError                String?
  retryCount               Int                  @default(0)
  lastAttemptAt            DateTime?
  syncedAt                 DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  payment                  Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([provider, status])
  @@index([externalOrderId])
  @@index([merchantOrderReference])
}

model IntegrationWebhookEvent {
  id         String              @id @default(uuid())
  provider   IntegrationProvider
  eventKey   String
  eventName  String?
  payload    Json
  processed  Boolean             @default(false)
  paymentId  String?
  lastError  String?
  createdAt  DateTime            @default(now())

  @@unique([provider, eventKey])
  @@index([paymentId])
  @@index([createdAt])
}

model MarketCategory {
  id                    String           @id @default(uuid())
  nameAr                String
  nameEn                String?
  slug                  String           @unique
  icon                  String?
  emoji                 String?
  parentId              String?
  sortOrder             Int              @default(0)
  isActive              Boolean          @default(true)
  requiresWeight        Boolean          @default(false)
  legacyCategory        String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?
  parent                MarketCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children              MarketCategory[] @relation("CategoryTree")
  listingsAsCategory    Listing[]        @relation("ListingMarketCategory")
  listingsAsSubcategory Listing[]        @relation("ListingMarketSubcategory")

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model Listing {
  id                String          @id @default(uuid())
  /// Null only for ADMIN_MANAGED listings. Real listings always have a user.
  sellerId          String?
  origin            ListingOrigin   @default(USER)
  /// Display-only identity. Never a User login, id, or foreign key.
  displayUsername   String?
  displaySellerName String?
  displayPhone      String?
  displayRegion     String?
  title             String
  arabicTitle       String
  description       String
  arabicDescription String
  price             Float
  currency          String          @default("SAR")
  category          ListingCategory
  categoryId        String?
  subcategoryId     String?
  breed             String?
  age               String?
  quantity          Int             @default(1)
  location          String
  arabicLocation    String
  country           Country
  contactPhone      String?
  weightKg          Float?
  images            String[]
  videoUrl          String?
  thumbnailUrl      String?
  videoDuration     Float?
  videoWidth        Int?
  videoHeight       Int?
  videoFileSize     Int?
  featured          Boolean         @default(false)
  pinned            Boolean         @default(false)
  featuredUntil     DateTime?
  pinnedUntil       DateTime?
  promoted          Boolean         @default(false)
  promotedUntil     DateTime?
  promotionWeight   Int             @default(0)
  promotionTier     String?
  status            ListingStatus   @default(active)
  views             Int             @default(0)
  commentsCount     Int             @default(0)
  editCount         Int             @default(0)
  expiresAt         DateTime?
  covenantAccepted    Boolean   @default(false)
  covenantAcceptedAt  DateTime?
  covenantVersion     String?
  sellerDeclaredSold  Boolean?
  sellerDeclaredSoldAt DateTime?
  deleteReason        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  seller            User?           @relation(fields: [sellerId], references: [id])
  marketCategory    MarketCategory? @relation("ListingMarketCategory", fields: [categoryId], references: [id])
  marketSubcategory MarketCategory? @relation("ListingMarketSubcategory", fields: [subcategoryId], references: [id])
  fee               ListingFee?
  boosts            ListingBoost[]
  promotions        ListingPromotion[]
  offers            ListingOffer[]
  stories           Story[]
  comments          ListingComment[]

  @@index([sellerId])
  @@index([origin])
  @@index([category])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([country])
  @@index([status])
  @@index([featured])
  @@index([pinned])
  @@index([promoted])
  @@index([promotionWeight])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([deletedAt])
}

model ListingBoost {
  id            String     @id @default(uuid())
  listingId     String
  userId        String
  boostType     BoostType
  durationDays  Int        @default(30)
  amount        Float
  currency      String     @default("SAR")
  status        FeeStatus  @default(pending)
  startsAt      DateTime?
  expiresAt     DateTime?
  transactionId String?
  paidAt        DateTime?
  paymentId     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  listing       Listing    @relation(fields: [listingId], references: [id])
  user          User       @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model ListingPromotion {
  id              String    @id @default(uuid())
  listingId       String
  userId          String
  tier            String    @default("standard")
  weight          Int       @default(100)
  durationDays    Int
  amount          Float
  currency        String    @default("SAR")
  status          FeeStatus @default(pending)
  startsAt        DateTime?
  expiresAt       DateTime?
  transactionId   String?
  paidAt          DateTime?
  paymentId       String?
  impressions     Int       @default(0)
  clicks          Int       @default(0)
  promotedViews   Int       @default(0)
  baselineViews   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  listing         Listing   @relation(fields: [listingId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([tier])
}

model ListingFee {
  id            String    @id @default(uuid())
  listingId     String    @unique
  userId        String
  category      String
  quantity      Int       @default(1)
  price         Float
  commission    Float
  status        FeeStatus @default(pending)
  dueDate       DateTime?
  saleAmount    Float?
  saleDeclaredAt DateTime?
  paidAt        DateTime?
  transactionId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  listing       Listing   @relation(fields: [listingId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  payments      Payment[]

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate])
}

model AdminAccountAction {
  id        String   @id @default(uuid())
  userId    String
  actorId   String
  action    String
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation("AccountActionTarget", fields: [userId], references: [id], onDelete: Cascade)
  actor     User     @relation("AccountActionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([actorId])
}

model ListingOffer {
  id        String   @id @default(uuid())
  listingId String
  buyerId   String
  amount    Float
  currency  String   @default("SAR")
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId])
}

model Post {
  id               String            @id @default(uuid())
  authorId         String
  content          String
  arabicContent    String
  image            String?
  images           String[]          @default([])
  isHidden         Boolean           @default(false)
  likesCount       Int               @default(0)
  repostsCount     Int               @default(0)
  commentsCount    Int               @default(0)
  viewsCount       Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  author           User              @relation(fields: [authorId], references: [id])
  comments         PostComment[]
  likes            PostLike[]
  reposts          PostRepost[]
  bookmarks        PostBookmark[]
  media            PostMedia[]
  knowledgeArticle KnowledgeArticle?

  @@index([authorId])
  @@index([createdAt])
  @@index([deletedAt])
}

model PostMedia {
  id        String        @id @default(uuid())
  postId    String
  url       String
  type      PostMediaType
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostRepost {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostBookmark {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model ListingComment {
  id        String   @id @default(uuid())
  listingId String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Story {
  id             String          @id @default(uuid())
  userId         String
  thumbnail      String
  mediaUrl       String?
  caption        String?
  captionAr      String?
  location       String?
  duration       Int             @default(5)
  isLive         Boolean         @default(false)
  liveStreamId   String?
  listingId      String?
  viewsCount     Int             @default(0)
  reactionsCount Int             @default(0)
  expiresAt      DateTime
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing        Listing?        @relation(fields: [listingId], references: [id], onDelete: SetNull)
  views          StoryView[]
  reactions      StoryReaction[]

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt, createdAt])
  @@index([expiresAt, createdAt])
  @@index([listingId])
  @@index([deletedAt])
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  viewerId  String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([storyId, createdAt])
  @@index([viewerId])
}

model StoryReaction {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId])
}

model LiveStream {
  id          String        @id @default(uuid())
  hostId      String
  title       String
  arabicTitle String
  thumbnail   String?
  category    String
  topic       String?
  streamKey   String        @unique @default(uuid())
  rtmpUrl     String?
  hlsUrl      String?
  isLive      Boolean       @default(false)
  viewers     Int           @default(0)
  peakViewers Int           @default(0)
  likes       Int           @default(0)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?
  comments    LiveComment[]
  host        User          @relation(fields: [hostId], references: [id])

  @@index([hostId])
  @@index([isLive])
  @@index([deletedAt])
}

model LiveComment {
  id          String     @id @default(uuid())
  streamId    String
  userId      String?
  username    String
  arabicName  String?
  message     String
  avatar      String?
  isOffer     Boolean    @default(false)
  offerAmount Float?
  createdAt   DateTime   @default(now())
  stream      LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([streamId, createdAt])
}

model Message {
  id         String        @id @default(uuid())
  threadId   String
  senderId   String
  receiverId String
  text       String?
  imageUrl   String?
  videoUrl   String?
  orderId    String?
  isRead     Boolean       @default(false)
  readAt     DateTime?
  createdAt  DateTime      @default(now())
  receiver   User          @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User          @relation("SentMessages", fields: [senderId], references: [id])
  thread     MessageThread @relation(fields: [threadId], references: [id])

  @@index([threadId])
  @@index([senderId])
  @@index([receiverId])
  @@index([threadId, createdAt])
}

model MessageThread {
  id            String            @id @default(uuid())
  participant1  String
  participant2  String
  type          MessageThreadType @default(DIRECT)
  butcherId     String?
  /// Unique conversation scope: "direct" or "butcher:{butcherId}"
  scopeKey      String            @default("direct")
  lastMessageAt DateTime          @default(now())
  createdAt     DateTime          @default(now())
  messages      Message[]
  states        MessageThreadState[]
  butcher       Butcher?          @relation(fields: [butcherId], references: [id], onDelete: SetNull)

  @@unique([participant1, participant2, scopeKey])
  @@index([participant1])
  @@index([participant2])
  @@index([lastMessageAt])
  @@index([type])
  @@index([butcherId])
}

model MessageThreadState {
  id       String         @id @default(uuid())
  threadId String
  userId   String
  pinnedAt DateTime?
  hiddenAt DateTime?
  thread   MessageThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@index([threadId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  titleAr   String
  bodyAr    String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model Activity {
  id           String   @id @default(uuid())
  actorId      String
  targetUserId String?
  type         String
  entityId     String?
  entityType   String?
  createdAt    DateTime @default(now())
  actor        User     @relation("ActivityActor", fields: [actorId], references: [id])
  target       User?    @relation("ActivityTarget", fields: [targetUserId], references: [id])

  @@index([actorId])
  @@index([targetUserId])
}

model Butcher {
  id                  String              @id @default(uuid())
  userId              String              @unique
  nameAr              String
  nameEn              String
  logo                String?
  cover               String?
  type                ButcherType         @default(regular)
  country             Country
  city                String
  cityAr              String
  address             String
  addressAr           String
  lat                 Float?
  lng                 Float?
  phone               String
  bioAr               String?
  bioEn               String?
  specialties         String[]
  commercialReg       String?
  subscriptionActive  Boolean             @default(false)
