}

enum AccountVerificationStatus {
  DRAFT
  UNDER_REVIEW
  NEEDS_AMENDMENTS
  VERIFIED
  REJECTED
}

enum AccountVerificationDocumentType {
  NATIONAL_ID
  COMMERCIAL_REGISTER
  OTHER
}

enum FaqCategory {
  ACCOUNT
  ADS
  MARKET
  BUY_SELL
  PAYMENT
  VERIFICATION
  BUTCHERS
  TECHNICAL
  GENERAL
}

enum KnowledgeSourceType {
  RSS
  API
}

enum KnowledgeArticleStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model KnowledgeSource {
  id        String              @id @default(uuid())
  name      String
  url       String
  type      KnowledgeSourceType @default(RSS)
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  articles  KnowledgeArticle[]
  syncLogs  KnowledgeSyncLog[]

  @@index([enabled])
  @@index([type])
}

model KnowledgeArticle {
  id            String                 @id @default(uuid())
  sourceId      String
  originalTitle String
  originalUrl   String                 @unique
  summary       String?
  titleAr       String?
  publishedAt   DateTime?
  status        KnowledgeArticleStatus @default(PENDING)
  postId        String?                @unique
  errorMessage  String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  source        KnowledgeSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  post          Post?                  @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
}

model KnowledgeSyncLog {
  id        String           @id @default(uuid())
  sourceId  String?
  level     String
  message   String
  meta      Json?
  createdAt DateTime         @default(now())
  source    KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([sourceId])
  @@index([level])
}

/// Admin-managed editorial / news stories shown on the home feed (image + article).
model EditorialStory {
  id          String    @id @default(uuid())
  titleAr     String
  bodyAr      String
  imageUrl    String
  duration    Int       @default(20)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([isActive, sortOrder])
  @@index([publishedAt])
  @@index([createdAt])
}

/// Admin-managed feed supplier directory (no user account).
model FeedSupplier {
  id          String        @id @default(uuid())
  nameAr      String
  logo        String?
  cover       String?
  description String?
  cityAr      String
  districtAr  String?
  addressAr   String?
  lat         Float?
  lng         Float?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  hoursAr     String?
  verified    Boolean       @default(false)
  published   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  products    FeedProduct[]

  @@index([deletedAt])
  @@index([published, deletedAt])
  @@index([cityAr])
}

model FeedProduct {
  id          String              @id @default(uuid())
  supplierId  String
  supplier    FeedSupplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  nameAr      String
  description String?
  category    FeedProductCategory
  imageUrl    String?
  weightLabel String?
  available   Boolean             @default(true)
  published   Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  @@index([supplierId, published])
  @@index([deletedAt])
  @@index([category])
}

enum FeedProductCategory {
  livestock
  sheep
  camels
  poultry
  hay
  barley
}

/// Admin-managed promotional banners on the butchers market home slider (3 slots).
model ButcherMarketBanner {
  id         String   @id @default(uuid())
  slot       Int      @unique
  titleAr    String
  subtitleAr String
  captionAr  String   @default("")
  imageUrl   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, slot])
}

/// Admin-managed image banners for the home “استكشف سرح” slider (independent of home-explore destinations).
model ExploreSarhBanner {
  id                 String   @id @default(uuid())
  imageUrl           String
  accessibilityLabel String
  href               String
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, sortOrder])
}
