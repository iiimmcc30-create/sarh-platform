  @@index([butcherId])
  @@index([customerId])
  @@index([status])
  @@index([butcherId, status])
  @@index([orderNumber])
  @@index([paymentStatus])
}

/// Temporary payment-first checkout. Final ButcherOrder is created only after N-Genius confirmation.
model ButcherCheckout {
  id              String                        @id @default(uuid())
  userId          String
  butcherId       String
  paymentId       String?                       @unique
  status          ButcherCheckoutStatus         @default(pending)
  expiresAt       DateTime
  deliveryType    String                        @default("pickup")
  deliveryAddress String?
  notes           String?
  currency        String                        @default("SAR")
  totalPrice      Float
  itemsSnapshot   Json
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  user            User                          @relation(fields: [userId], references: [id])
  butcher         Butcher                       @relation(fields: [butcherId], references: [id])
  payment         Payment?                      @relation(fields: [paymentId], references: [id])
  order           ButcherOrder?
  reservations    ButcherCheckoutReservation[]

  @@index([userId, status])
  @@index([butcherId, status])
  @@index([status, expiresAt])
}

model ButcherCheckoutReservation {
  id          String                       @id @default(uuid())
  checkoutId  String
  userId      String
  productId   String
  quantity    Float
  status      ButcherReservationStatus     @default(held)
  expiresAt   DateTime
  releasedAt  DateTime?
  createdAt   DateTime                     @default(now())
  checkout    ButcherCheckout              @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  user        User                         @relation(fields: [userId], references: [id])
  product     ButcherProduct               @relation(fields: [productId], references: [id])

  @@index([checkoutId])
  @@index([userId, status])
  @@index([productId, status])
  @@index([status, expiresAt])
}

model ButcherOrderItem {
