model AccountVerificationDocument {
  id               String                          @id @default(uuid())
  requestId        String
  type             AccountVerificationDocumentType
  fileKey          String
  fileUrl          String
  originalFileName String?
  mimeType         String?
  fileSizeBytes    Int?
  createdAt        DateTime                        @default(now())
  request          AccountVerificationRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model AccountVerificationTimelineEvent {
  id        String                     @id @default(uuid())
  requestId String
  action    String
  actorId   String?
  note      String?
  createdAt DateTime                   @default(now())
  request   AccountVerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([createdAt])
}

model Faq {
