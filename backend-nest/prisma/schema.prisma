  country         Country
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
  butcher         Butcher   @relation(fields: [butcherId], references: [id])

  @@index([butcherId])
  @@index([validUntil])
  @@index([deletedAt])
}

model ButcherStory {
  id        String    @id @default(uuid())
  butcherId String
  thumbnail String
  caption   String?
  captionAr String?
  mediaUrl  String?
  duration  Int       @default(15)
  type      StoryType
  seen      Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  butcher   Butcher   @relation(fields: [butcherId], references: [id])

  @@index([butcherId])
  @@index([expiresAt])
  @@index([deletedAt])
