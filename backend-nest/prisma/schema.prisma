model SupportTicket {
  id           String                    @id @default(uuid())
  ticketNumber String                    @unique
  type         SupportTicketType         @default(SUPPORT)
  category     String
  priority     TicketPriority            @default(NORMAL)
  status       TicketStatus              @default(OPEN)
  handlerMode  SupportHandlerMode        @default(HUMAN_ACTIVE)
  subject      String
  description  String
  adminNotes   String?
  reporterId   String?
  assignedToId String?
  metadata     Json?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  closedAt     DateTime?
  deletedAt    DateTime?
  reporter     User?                     @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  assignedTo   User?                     @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     SupportTicketMessage[]
  attachments  SupportTicketAttachment[]

  @@index([status])
  @@index([category])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([reporterId])
  @@index([assignedToId])
  @@index([handlerMode])
}

model SupportTicketMessage {
  id           String                    @id @default(uuid())
  ticketId     String
  authorId     String?
  authorKind   SupportMessageAuthor      @default(CUSTOMER)
  body         String
  isStaffReply Boolean                   @default(false)
  createdAt    DateTime                  @default(now())
  ticket       SupportTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User?                     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments  SupportTicketAttachment[]

  @@index([ticketId])
  @@index([authorId])
  @@index([createdAt])
}

model SupportTicketAttachment {
  id            String                @id @default(uuid())
  ticketId      String
  messageId     String?
  fileUrl       String
  fileName      String?
  mimeType      String?
  fileSizeBytes Int?
  createdAt     DateTime              @default(now())
  ticket        SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message       SupportTicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([messageId])
}

model AccountVerificationRequest {
  id             String                           @id @default(uuid())
  userId         String                           @unique
  status         AccountVerificationStatus        @default(DRAFT)
  /// Tier the user applied for: "blue" (individual) | "gold" (merchant).
  requestedTier  String?
  /// Tier currently approved by admin review (kept while an upgrade is reviewed).
  approvedTier   String?
  fullName       String?
  nationalId     String?
  businessName   String?
  businessType   String?
  additionalInfo String?
  reviewReason   String?
  adminNotes     String?
  reviewedById   String?
  reviewedAt     DateTime?
  submittedAt    DateTime?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  user           User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy     User?                            @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents      AccountVerificationDocument[]
  timeline       AccountVerificationTimelineEvent[]

  @@index([status])
  @@index([submittedAt])
