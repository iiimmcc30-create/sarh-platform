  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
}

model KnowledgeSyncLog {
  id        String           @id @default(uuid())
  sourceId  String?
  level     String
  message   String
  meta      Json?
  createdAt DateTime         @default(now())
  source    KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([sourceId])
  @@index([level])
}

/// Admin-managed editorial / news stories shown on the home feed (image + article).
model EditorialStory {
  id          String    @id @default(uuid())
  titleAr     String
  bodyAr      String
  imageUrl    String
  duration    Int       @default(20)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([isActive, sortOrder])
  @@index([publishedAt])
  @@index([createdAt])
}

/// Admin-managed feed supplier directory (no user account).
model FeedSupplier {
  id          String        @id @default(uuid())
  nameAr      String
  logo        String?
  cover       String?
  description String?
  cityAr      String
  districtAr  String?
  addressAr   String?
  lat         Float?
  lng         Float?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  hoursAr     String?
  verified    Boolean       @default(false)
  published   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  products    FeedProduct[]

  @@index([deletedAt])
  @@index([published, deletedAt])
  @@index([cityAr])
}

model FeedProduct {
  id          String              @id @default(uuid())
  supplierId  String
  supplier    FeedSupplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  nameAr      String
  description String?
  category    FeedProductCategory
  imageUrl    String?
  weightLabel String?
  available   Boolean             @default(true)
  published   Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  @@index([supplierId, published])
  @@index([deletedAt])
  @@index([category])
}

enum FeedProductCategory {
  livestock
  sheep
  camels
  poultry
  hay
  barley
}

/// Admin-managed image banners for the home “استكشف سرح” slider (independent of home-explore destinations).
model ExploreSarhBanner {
  id                 String   @id @default(uuid())
  imageUrl           String
  accessibilityLabel String
  href               String
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// PDPL consent log: one row per user × policy × version. Written at signup
/// and when the user accepts a newer privacy policy. Kept after account
/// deletion (proof of consent) with ip / userAgent cleared.
model ConsentRecord {
  id            String   @id @default(uuid())
  userId        String
  /// "privacy" (privacy policy). Room for "terms" later.
  policy        String   @default("privacy")
  policyVersion String
  /// "signup" | "policy_update"
  source        String?
  acceptedAt    DateTime @default(now())
  ip            String?
  userAgent     String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, policy, policyVersion])
  @@index([userId])
}

/// Durable queue of stored media to delete (account deletion: listing/post/
/// story/chat media, avatar/cover, identity documents). Processed by the
/// worker cron in small batches with retries; rows are never re-used.
model MediaDeletionJob {
  id          String    @id @default(uuid())
  url         String
  reason      String
  userId      String?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt, createdAt])
  @@index([userId])
}
