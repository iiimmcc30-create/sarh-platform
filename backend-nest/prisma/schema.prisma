  rating              Float               @default(0)
  reviewCount         Int                 @default(0)
  orderCompletionRate Float               @default(100)
  activityScore       Int                 @default(50)
  profileViews        Int                 @default(0)
  totalOrders         Int                 @default(0)
  completedOrdersCount Int                @default(0)
  favoritesCount      Int                 @default(0)
  avgAcceptMinutes    Float?
  avgPrepMinutes      Float?
  avgCompleteMinutes  Float?
  rankingScore        Float               @default(0)
  normalizedOrders    Float               @default(0)
  normalizedRating    Float               @default(0)
  normalizedFavorites Float               @default(0)
  normalizedDistance  Float               @default(50)
  normalizedSpeed     Float               @default(0)
  newButcherBoost     Float               @default(0)
  lastRankingUpdate   DateTime?
  openTime            String              @default("06:00")
  closeTime           String              @default("22:00")
  closedDays          String[]
  isOpen              Boolean             @default(true)
  sourceApplicationId String?             @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  user                User                @relation(fields: [userId], references: [id])
  sourceApplication   ButcherApplication? @relation("ButcherSourceApplication", fields: [sourceApplicationId], references: [id])
  daftraIntegration   ButcherDaftraIntegration?
  daftraProductLinks  ButcherDaftraProduct[]
  offers              ButcherOffer[]
  orders              ButcherOrder[]
  checkouts           ButcherCheckout[]
  products            ButcherProduct[]
  reviews             ButcherReview[]
  stories             ButcherStory[]
  messageThreads      MessageThread[]
  favorites           ButcherFavorite[]

  @@index([country])
  @@index([subscriptionActive])
  @@index([rating])
  @@index([country, subscriptionActive, rating])
  @@index([deletedAt])
  @@index([rankingScore])
  @@index([completedOrdersCount])
  @@index([favoritesCount])
  @@index([createdAt])
  @@index([lat, lng])
}

model ButcherProduct {
