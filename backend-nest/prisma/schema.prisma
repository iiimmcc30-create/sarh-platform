/// How Sarh authenticates to Daftra for this butcher.
enum DaftraAuthMethod {
  API_KEY
  OAUTH
  BOTH
}

model ButcherDaftraIntegration {
  id                   String                   @id @default(uuid())
  butcherId            String                   @unique
  /// Daftra account/subdomain identifier used to build https://{account}.daftra.com
  accountIdentifier    String
  /// API key fields — required for API_KEY / BOTH; null when OAuth-only.
  apiKeyCiphertext     String?
  apiKeyIv             String?
  apiKeyTag            String?
  apiKeyLast4          String?
  authMethod           DaftraAuthMethod         @default(API_KEY)
  /// OAuth provider label (currently only "daftra").
  oauthProvider        String?
  accessTokenCiphertext String?
  accessTokenIv         String?
  accessTokenTag        String?
  refreshTokenCiphertext String?
  refreshTokenIv         String?
  refreshTokenTag        String?
  accessTokenExpiresAt   DateTime?
  /// Space-separated scopes as returned/stored; never invent scopes.
  oauthScopes            String?
  oauthConnectedAt       DateTime?
  status               DaftraIntegrationStatus  @default(NOT_CONFIGURED)
  lastConnectionTestAt DateTime?
  lastConnectionError  String?
  daftraLoginEmail     String?
  daftraLoginUrl       String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  butcher              Butcher                  @relation(fields: [butcherId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([oauthProvider])
}

model ButcherDaftraProduct {
  id                String   @id @default(uuid())
  butcherId         String
  sarhProductId     String?  @unique
  daftraProductId   Int
  daftraProductCode String?
  daftraSaleUnit    String?
  lastKnownQuantity Float?
  lastSyncedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  butcher           Butcher         @relation(fields: [butcherId], references: [id], onDelete: Cascade)
  sarhProduct       ButcherProduct? @relation(fields: [sarhProductId], references: [id], onDelete: SetNull)

  @@unique([butcherId, daftraProductId])
  @@index([butcherId])
}

model SupportTicket {
  id           String                    @id @default(uuid())
  ticketNumber String                    @unique
  type         SupportTicketType         @default(SUPPORT)
  category     String
  priority     TicketPriority            @default(NORMAL)
  status       TicketStatus              @default(OPEN)
  handlerMode  SupportHandlerMode        @default(HUMAN_ACTIVE)
  subject      String
  description  String
  adminNotes   String?
  reporterId   String?
  assignedToId String?
  orderId      String?
  metadata     Json?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  closedAt     DateTime?
  deletedAt    DateTime?
  reporter     User?                     @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  assignedTo   User?                     @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  order        ButcherOrder?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages     SupportTicketMessage[]
  attachments  SupportTicketAttachment[]

  @@index([status])
  @@index([category])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([reporterId])
  @@index([assignedToId])
  @@index([orderId])
  @@index([handlerMode])
}

model SupportTicketMessage {
  id           String                    @id @default(uuid())
  ticketId     String
  authorId     String?
  authorKind   SupportMessageAuthor      @default(CUSTOMER)
  body         String
  isStaffReply Boolean                   @default(false)
  createdAt    DateTime                  @default(now())
  ticket       SupportTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User?                     @relation(fields: [authorId], references: [id], onDelete: SetNull)
