# ─────────────────────────────────────────────
# SARH Backend — Environment Variables Template
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
NODE_ENV=production
PORT=3001
# Frontend / deep-link return after Network International hosted checkout
APP_URL=https://your-api-domain.com
# Optional keep-alive targets (worker + GitHub cron). Defaults to production Render URLs.
# API_HEALTH_URL=https://sarh-new4.onrender.com/api/health
# SOCKET_HEALTH_URL=https://sarh-socket.onrender.com/health
APP_DEEP_LINK_SCHEME=sarh
APP_ANDROID_PACKAGE=com.sarh.app

# ── Database (Supabase) ───────────────────────
# Runtime: transaction pooler (port 6543) + pgbouncer=true
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30
# Migrations / pg_dump: session pooler (port 5432) or direct host
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connect_timeout=30
# Legacy Railway (migration source only — do not use in production):
# RAILWAY_DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# ── Redis ────────────────────────────────────
# Runtime prefers REDIS_URL; REDIS_HOST/PORT/PASSWORD are fallbacks.
# Production validator accepts either REDIS_URL or REDIS_HOST.
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ── JWT Auth ─────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Session row TTL in DB (days)
SESSION_TTL_DAYS=30

# ── Network International (NI) — KSA ─────────────────────────────────────────
# Identity:  {NI_BASE_URL}/identity/auth/access-token
# Orders:    {NI_BASE_URL}/transactions/outlets/{OUTLET_ID}/orders
#
# NI_BASE_URL:
#   KSA Live     → https://api-gateway.ksa.ngenius-payments.com
#   KSA Sandbox  → https://api-gateway.sandbox.ksa.ngenius-payments.com
NI_BASE_URL=https://api-gateway.ksa.ngenius-payments.com

# Outlet Reference from the NI merchant portal (Settings → Outlets)
NI_OUTLET_ID=your-ni-outlet-id

# API Key from NI portal (Settings → API Keys / Service Account)
NI_API_KEY=your_ni_api_key_here

# Optional: full Basic credential if the portal gives a ready Base64 value.
# When set it TAKES PRECEDENCE over NI_API_KEY for the access-token call —
# update or remove it whenever the merchant account / API key changes.
# NI_BASIC_AUTH=Base64StringFromPortal

# Realm: UAT/sandbox → ni | Production → networkinternational
NI_REALM=ni
NI_CHAIN_ID=

# Webhook secret for verifying NI webhook signatures
NI_WEBHOOK_SECRET=your_ni_webhook_secret_here
# Optional: header name N-Genius sends with NI_WEBHOOK_SECRET as its value (portal → Webhooks → Header Key). Default: x-sarh-webhook-secret
# NI_WEBHOOK_HEADER=x-sarh-webhook-secret

# Do not send Sarh merchant refs (FTR-/SFAT-/PRM-) as NI GET /orders/{uuid}.
# merchantOrderReference = Sarh Payment.orderId
# NI order UUID = Payment.transactionId / IntegrationOrder.externalOrderId

# ── Allowed CORS Origins ──────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8081,https://your-app-domain.com

# ── Storage / Media ──────────────────────────
STORAGE_URL=https://your-storage-bucket.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-south-1
# Runtime reads AWS_S3_BUCKET, then AWS_BUCKET_NAME.
AWS_S3_BUCKET=sarh-media
# AWS_BUCKET_NAME=sarh-media

# ── Notifications ─────────────────────────────
# Expo Push Notification Service (optional)
EXPO_ACCESS_TOKEN=

# Official MEWA account password (hashed at runtime; never commit the value)
MEWA_ACCOUNT_PASSWORD=

# ── Knowledge Center ─────────────────────────
# Auto-publish summarized articles as posts (default: true)
KNOWLEDGE_AUTO_PUBLISH=true
# Max items fetched per source each sync
KNOWLEDGE_MAX_ITEMS_PER_SOURCE=10
# Optional OpenAI key for better Arabic summaries (fallback summarizer used if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional «مساعد سرح» (Sarh Assistant) support bot. Leave unset in local/dev to use the heuristic provider.
# Never put keys in the app, Expo public env, Git, or logs.
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# ── Admin Seed ───────────────────────────────
ADMIN_EMAIL=sarh@sarhsa.online
ADMIN_PASSWORD=change-me-in-production
# Required in production (worker daily cleanup). Never log this value.
CRON_SECRET=change-me-cron-secret
