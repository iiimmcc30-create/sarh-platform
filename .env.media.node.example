# Additional LiveKit node (any provider): copy to .env.media on the NEW VPS. Config only - no code change.
# Must use the same key/secret and the same Redis as node 1.
LIVEKIT_API_KEY=sarh
LIVEKIT_API_SECRET=<same as node 1>
RTC_DOMAIN=rtc2.getsarh.com
TURN_DOMAIN=turn2.getsarh.com
NODE_IP=<public IPv4 of THIS node>
WEBHOOK_URL=https://getsarh.com/api/livekit/webhook

# Redis reached over a WireGuard tunnel (preferred across providers): plain redis inside the tunnel.
REDIS_ADDRESS=10.8.0.1:6379
REDIS_PASSWORD=<same as node 1>
REDIS_TLS=false
# ...or Redis over the public internet with mutual TLS (no WireGuard): use the public name + the files from gen-redis-tls.sh
# REDIS_ADDRESS=redis.getsarh.com:6379
# REDIS_TLS=true
# REDIS_TLS_SERVER_NAME=redis.getsarh.com
# REDIS_TLS_CA_FILE=/redis-tls/ca.crt
# REDIS_TLS_CLIENT_CERT_FILE=/redis-tls/client.crt
# REDIS_TLS_CLIENT_KEY_FILE=/redis-tls/client.key

ROOM_MAX_PARTICIPANTS=0
NODE_SYSLOAD_LIMIT=0.8
NODE_BYTES_PER_SEC=0
EGRESS_WS_URL=ws://127.0.0.1:7880
