# Copy to /opt/sarh/.env.production — NEVER commit the real file.
# Generate scaffold: scripts/hostinger/00-init-production-env.sh
# Validate (no secret output): scripts/hostinger/validate-env.sh

# ── Hostinger Postgres (local Docker) ──
POSTGRES_USER=sarh
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=sarh

# ── Redis (local Docker) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ENABLED=true

# ── App core ──
NODE_ENV=production
PORT=3001
APP_URL=https://sarhsa.online
ALLOWED_ORIGINS=https://sarhsa.online,https://www.sarhsa.online
APP_DEEP_LINK_SCHEME=sarh
APP_ANDROID_PACKAGE=com.sarh.app

# ── Database (compose overrides in docker-compose.prod.yml; keep for CLI) ──
DATABASE_URL=postgresql://sarh:PASSWORD@postgres:5432/sarh
DIRECT_URL=postgresql://sarh:PASSWORD@postgres:5432/sarh

# ── Auth ──
# JWT_SECRET is also injected into the admin container (docker-compose.prod.yml)
# so Next.js middleware can verify admin_token cookies. Must match the API.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ── Storage (production requires cloudinary or s3) ──
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=safat
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-south-1
AWS_S3_BUCKET=
STORAGE_URL=

# ── Payments (Network International) ──
NI_BASE_URL=
NI_OUTLET_ID=
NI_API_KEY=
NI_WEBHOOK_SECRET=
NI_REALM=networkinternational
# NI_BASIC_AUTH overrides NI_API_KEY when non-empty — keep it in sync or leave empty.
NI_BASIC_AUTH=
NI_CHAIN_ID=

# ── In-app purchases (native iOS / Android digital services) ──
# Optional until the store products are live (startup only warns).
# Guide: docs/iap-setup-ar.md. Never commit real values.
# Apple — App Store Connect → Users and Access → Integrations → In-App Purchase key
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Contents of SubscriptionKey_XXXX.p8 (one line with \n, or base64 of the file)
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=com.sarh.app
# Optional: numeric Apple ID of the app (App Store Connect → App Information)
APPLE_IAP_APP_APPLE_ID=
# Google — Play Console service account JSON (raw JSON on one line, or base64)
GOOGLE_PLAY_PACKAGE_NAME=com.sarh.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Pub/Sub push subscription → https://sarhsa.online/api/store-purchases/google/rtdn
# Audience configured on the push subscription (authentication enabled):
GOOGLE_PLAY_RTDN_AUDIENCE=
# Service account email the push subscription authenticates as:
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=

# ── OTP / SMS ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Push / Email ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=sarh@sarhsa.online
EXPO_ACCESS_TOKEN=

# ── Socket ──
SOCKET_PORT=3002
SOCKET_HTTP_PORT=3002

# ── Ops / optional ──
CRON_SECRET=CHANGE_ME_CRON_SECRET
SENTRY_DSN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# «مساعد سرح» guards — see backend-nest/.env.example (all optional, default ON / current behaviour)
# SARH_AI_ENABLED=true
# SARH_ASSISTANT_ENABLED=true
# SARH_AI_EMAIL_ALERTS_ENABLED=true
# SARH_AI_TIMEOUT_MS=15000
# SARH_AI_DAILY_TOKEN_BUDGET=1000000
# SARH_AI_DAILY_REQUEST_LIMIT=2000
# Support inbox for handoff alerts (needs SMTP_*). Empty = no alert e-mail.
SUPPORT_ALERT_EMAIL=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional («المجالس»): Agora RESTful API customer key/secret — enables server-side
# kicking-rules (instant kick/ban/mute at the media layer). Leave empty to skip.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
LOG_LEVEL=info
NODE_OPTIONS_BUILD=--max-old-space-size=3072

# One-time Render backup only (remove after import)
# RENDER_DATABASE_URL=
