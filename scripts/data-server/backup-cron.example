# DATA SERVER cron — prefer the installer (idempotent, keeps other crontab lines):
#   sudo SARH_ROOT=/opt/sarh ./scripts/data-server/install-backup-cron.sh
#
# That installs:
#   03:15 daily   scripts/data-server/run-backup-job.sh
#                 (pg_dump, then encrypted off-site upload, email on failure)
#   04:30 Sunday scripts/data-server/run-restore-drill.sh
#
# Configure RCLONE_REMOTE plus BACKUP_AGE_RECIPIENT or BACKUP_RCLONE_CRYPT=1,
# and SMTP_* so failures mail sarh@getsarh.com. See docs/BACKUP_RUNBOOK.md.
#
# Equivalent lines, if you edit crontab by hand:
# 15 3 * * * SARH_ROOT=/opt/sarh /opt/sarh/scripts/data-server/run-backup-job.sh >> /var/log/sarh-backup.log 2>&1
# 30 4 * * 0 SARH_ROOT=/opt/sarh /opt/sarh/scripts/data-server/run-restore-drill.sh >> /var/log/sarh-restore-verify.log 2>&1
