# DATA SERVER cron — install with: crontab -e   (root). Times are server-local.
# Replaces the old line that called scripts/hostinger/09-backup-postgres.sh
# (same BACKUP_DIR and sarh-*.dump naming, so existing dumps are kept/pruned together).
#
# Daily pg_dump at 03:15, keep newest BACKUP_MIN_KEEP (7) and anything newer than RETENTION_DAYS (14)
15 3 * * * SARH_ROOT=/opt/sarh /opt/sarh/scripts/data-server/backup-postgres.sh >> /var/log/sarh-backup.log 2>&1
#
# Weekly restore drill (Sunday 04:30): restores the latest dump into a throwaway
# container and checks tables/row counts/_prisma_migrations. Alert on "FAILED".
30 4 * * 0 SARH_ROOT=/opt/sarh /opt/sarh/scripts/data-server/restore-verify.sh --compare-live >> /var/log/sarh-restore-verify.log 2>&1
#
# REQUIRED off-site copy — a backup on the same server/volume is not a backup.
# Configure rclone (or restic/S3) on the server, not in Git:
# 45 3 * * * rclone copy /opt/backups/sarh/postgres remote:sarh-backups/postgres/ --min-age 5m >> /var/log/sarh-backup-sync.log 2>&1
