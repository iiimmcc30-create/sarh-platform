# DATA SERVER env — copy to /opt/sarh/.env.data on the data server. NEVER commit.
# Used by docker-compose.data.yml and scripts/data-server/*.
# Validate (no secret output): ENV_PROFILE=data ENV_FILE=/opt/sarh/.env.data scripts/hostinger/validate-env.sh

# ── Bind address for PostgreSQL/Redis ──
# Provider private-network IP of THIS server, or its WireGuard tunnel IP (wg0).
# Never 0.0.0.0 and never the public IP.
DATA_SERVER_PRIVATE_IP=DATA_SERVER_PRIVATE_IP
# App server private/tunnel IP — the only client allowed by the firewall scripts.
APP_SERVER_PRIVATE_IP=APP_SERVER_PRIVATE_IP

# ── PostgreSQL (existing cluster: copy the SAME values from .env.production — do not rotate) ──
POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_DB=POSTGRES_DB

# ── Existing Docker volumes (verify with: docker volume ls) ──
POSTGRES_VOLUME_NAME=sarh_postgres_data
REDIS_VOLUME_NAME=sarh_redis_data

# ── Redis ──
# New: required now that Redis is reachable over a network. Must match the app
# server .env.app. URL-safe recommended: openssl rand -hex 32
REDIS_PASSWORD=REDIS_PASSWORD
# Same as docker-compose.prod.yml unless you resize the server.
REDIS_MAXMEMORY=256mb

# ── Optional resource limits (defaults = current docker-compose.prod.yml values) ──
# POSTGRES_MEM_LIMIT=768m
# POSTGRES_CPUS=1.0
# REDIS_MEM_LIMIT=384m
# REDIS_CPUS=0.50

# ── Backups (scripts/data-server/backup-postgres.sh) ──
BACKUP_DIR=/opt/backups/sarh/postgres
RETENTION_DAYS=14
BACKUP_MIN_KEEP=7

# ── Off-site copy (scripts/data-server/backup-offsite.sh) ──
# rclone remote for Backblaze B2, Cloudflare R2, or Contabo Object Storage.
# RCLONE_REMOTE=b2:sarh-backups
# Encrypt with age, or point RCLONE_REMOTE at an rclone crypt remote.
# Plaintext uploads are refused.
# BACKUP_AGE_RECIPIENT=age1xxxxxxxx
# BACKUP_RCLONE_CRYPT=0
# BACKUP_OFFSITE_PREFIX=backups
# BACKUP_OFFSITE_RETENTION_DAYS=30
# BACKUP_OFFSITE_MIN_KEEP=7

# Failure mail. Unset ALERT_EMAIL_TO still defaults to sarh@getsarh.com.
ALERT_EMAIL_TO=sarh@getsarh.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=sarh@getsarh.com
# Telegram is optional and off. Set to 1 only with TELEGRAM_ALERT_BOT_TOKEN and TELEGRAM_ALERT_CHAT_ID.
# BACKUP_ALERT_TELEGRAM=0
