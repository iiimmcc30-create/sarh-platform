# Egress-only worker (HLS). Runs only the egress container:
#   docker compose -f docker-compose.media.yml --env-file .env.media --profile egress up -d egress
# It needs Redis (same as the LiveKit nodes) and a LiveKit URL to join rooms; it serves no viewers.
LIVEKIT_API_KEY=sarh
LIVEKIT_API_SECRET=<same as the LiveKit nodes>
# Same Redis access as the nodes: WireGuard IP, or public name + mutual TLS (see .env.media.node.example)
REDIS_ADDRESS=10.8.0.1:6379
REDIS_PASSWORD=<same>
REDIS_TLS=false
# Public signalling entry of the cluster (the worker is remote from the LiveKit nodes)
EGRESS_WS_URL=wss://rtc.getsarh.com
