# Copy to .env.media on the media VPS. Never commit .env.media.
# Docs: docs/livekit.md (single node) and docs/livekit-scaling.md (multi-node, HLS).

# --- required ---
LIVEKIT_API_KEY=sarh
# Generate: openssl rand -hex 32   (the SAME key/secret goes into the backend env)
LIVEKIT_API_SECRET=

# --- this node's names ---
RTC_DOMAIN=rtc.getsarh.com
TURN_DOMAIN=turn.getsarh.com
# Public IPv4 of THIS node. Leave empty on a single node (auto-detected); set it on every node of a cluster.
NODE_IP=

# --- where the backend receives webhooks ---
WEBHOOK_URL=https://getsarh.com/api/livekit/webhook

# --- optional: Redis (multi-node and/or Egress). Empty = standalone single node. ---
# Private/VPN address of the Redis host, e.g. 10.8.0.1:6379 - never a public unauthenticated port.
REDIS_ADDRESS=
REDIS_USERNAME=
REDIS_PASSWORD=
# true when Redis is reached over TLS (managed rediss, or our mutual-TLS Redis below).
# Plain redis is only acceptable on loopback or inside a WireGuard tunnel.
REDIS_TLS=false
# Only on the node that runs `--profile redis`: interface to bind (default 127.0.0.1).
# Cross-provider: the WireGuard address (e.g. 10.8.0.1). Never 0.0.0.0 without TLS+firewall.
REDIS_BIND_IP=127.0.0.1
# Serve Redis over mutual TLS (requires infra/media/secrets/redis-tls/{ca.crt,redis.crt,redis.key}).
REDIS_TLS_SERVER=false
# Client side (every LiveKit/Egress node) when REDIS_TLS=true with our private CA:
# REDIS_TLS_SERVER_NAME=redis.getsarh.com
# REDIS_TLS_CA_FILE=/redis-tls/ca.crt
# REDIS_TLS_CLIENT_CERT_FILE=/redis-tls/client.crt
# REDIS_TLS_CLIENT_KEY_FILE=/redis-tls/client.key

# --- per-node safety limits (0 = off) ---
# Hard ceiling per room enforced by LiveKit itself (set >= your backend per-room caps)
ROOM_MAX_PARTICIPANTS=0
# New rooms avoid nodes above this system load (multi-node only)
NODE_SYSLOAD_LIMIT=0.8
# Node bandwidth ceiling in bytes/sec, e.g. 31250000 = 250 Mbps on a 300 Mbps port
NODE_BYTES_PER_SEC=0

# --- egress (only with --profile egress) ---
# ws://127.0.0.1:7880 when egress runs on a LiveKit node; otherwise wss://rtc.getsarh.com
EGRESS_WS_URL=ws://127.0.0.1:7880
