# NEXT_PUBLIC_API_URL — Backend API (Railway or local). Must be :3001 locally, NOT admin :3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
# Socket.IO server (same host as backend gateway, default :3002)
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3002

# JWT_SECRET must match the backend access-token secret so middleware can
# verify admin_token cookies (HS256). Never commit the real value.
JWT_SECRET=change-me-min-32-characters-long!!
