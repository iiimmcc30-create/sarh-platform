# APP SERVER env — copy to /opt/sarh/.env.app on the app server. NEVER commit.
# Used by docker-compose.app.yml (interpolation + container env_file).
# Validate (no secret output): ENV_PROFILE=app ENV_FILE=/opt/sarh/.env.app scripts/hostinger/validate-env.sh
#
# Start from your current .env.production (all app secrets stay identical), then:
#   - add DATA_SERVER_PRIVATE_IP and REDIS_PASSWORD
#   - remove/ignore REDIS_URL, REDIS_HOST=redis, DATABASE_URL/DIRECT_URL with host "postgres"
#     (docker-compose.app.yml builds DATABASE_URL/DIRECT_URL/REDIS_* itself)

# ── Data server (private network IP or WireGuard tunnel IP) ──
DATA_SERVER_PRIVATE_IP=DATA_SERVER_PRIVATE_IP
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── PostgreSQL credentials (same as the data server — existing values, not rotated) ──
# Embedded verbatim in DATABASE_URL: must be URL-safe ([A-Za-z0-9._~-]) or
# percent-encoded. validate-env.sh flags unsafe characters.
POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_DB=POSTGRES_DB
# Optional query string appended to DATABASE_URL / DIRECT_URL, e.g.
#   DATABASE_URL_PARAMS=?connection_limit=10
#   DATABASE_URL_PARAMS=?sslmode=require   (only after enabling TLS on PostgreSQL)
DATABASE_URL_PARAMS=
DIRECT_URL_PARAMS=

# ── Redis (same REDIS_PASSWORD as .env.data) ──
REDIS_PASSWORD=REDIS_PASSWORD
REDIS_ENABLED=true

# ── Migrations: never on boot in the two-server setup ──
# Apply manually: scripts/app-server/migrate.sh (status first, then deploy).
SKIP_MIGRATIONS=true

# ── App core ──
NODE_ENV=production
PORT=3001
APP_URL=https://sarhsa.online
ALLOWED_ORIGINS=https://sarhsa.online,https://www.sarhsa.online
APP_DEEP_LINK_SCHEME=sarh
APP_ANDROID_PACKAGE=com.sarh.app

# ── Auth ──
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ── Storage ──
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=safat
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-south-1
AWS_S3_BUCKET=
STORAGE_URL=

# ── Payments (Network International) ──
NI_BASE_URL=
NI_OUTLET_ID=
NI_API_KEY=
NI_WEBHOOK_SECRET=
NI_REALM=networkinternational
NI_BASIC_AUTH=
NI_CHAIN_ID=

# ── OTP / SMS ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Push / Email ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=sarh@sarhsa.online
EXPO_ACCESS_TOKEN=

# ── Socket ──
SOCKET_PORT=3002
SOCKET_HTTP_PORT=3002

# ── Ops / optional ──
CRON_SECRET=
SENTRY_DSN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional («المجالس»): Agora RESTful API customer key/secret — enables server-side
# kicking-rules (instant kick/ban/mute at the media layer). Leave empty to skip.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
LOG_LEVEL=info
NODE_OPTIONS_BUILD=--max-old-space-size=3072
