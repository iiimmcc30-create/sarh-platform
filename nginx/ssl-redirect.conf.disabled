# Enabled by scripts/hostinger/06-setup-ssl.sh after certificate issuance.
# ACME http-01 challenges are exempt: a server-level `return` runs before
# location matching and would otherwise break certbot webroot renewals.
if ($request_uri !~ "^/\.well-known/acme-challenge/") {
  return 301 https://$host$request_uri;
}
