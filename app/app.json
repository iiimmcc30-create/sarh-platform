{
  "expo": {
    "name": "Sarh",
    "slug": "safat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sarh",
    "owner": "sarhplatform-team",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.sarh.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "سرح | Sarh",
        "NSCameraUsageDescription": "يستخدم سرح الكاميرا لالتقاط الصور ومقاطع الفيديو لإعلاناتك ومنشوراتك وقصصك ومحادثاتك، وللظهور في البث المباشر عند بدئك له.",
        "NSPhotoLibraryUsageDescription": "يحتاج سرح إلى الوصول لمكتبة الصور لتختار منها صور ومقاطع إعلاناتك ومنشوراتك وقصصك وصورة ملفك الشخصي والغلاف، ولإرفاقها في المحادثات وطلبات الدعم.",
        "NSMicrophoneUsageDescription": "يستخدم سرح الميكروفون لتسجيل الرسائل الصوتية في المحادثات، وللتحدث في المجالس والبث المباشر، ولتسجيل صوت مقاطع الفيديو.",
        "NSLocationWhenInUseUsageDescription": "يستخدم سرح موقعك أثناء استخدام التطبيق فقط لاقتراح مدينتك وتحديد موقع إعلانك على الخريطة ومشاركة موقعك في المحادثات عند طلبك.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "associatedDomains": [
        "applinks:sarhsa.online",
        "applinks:www.sarhsa.online"
      ],
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.sarh.app",
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "com.android.vending.BILLING"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#020202"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sarhsa.online",
              "pathPrefix": "/l/"
            },
            {
              "scheme": "https",
              "host": "sarhsa.online",
              "pathPrefix": "/post/"
            },
            {
              "scheme": "https",
              "host": "sarhsa.online",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "sarhsa.online",
              "pathPrefix": "/councils/join/"
            },
            {
              "scheme": "https",
              "host": "www.sarhsa.online",
              "pathPrefix": "/l/"
            },
            {
              "scheme": "https",
              "host": "www.sarhsa.online",
              "pathPrefix": "/post/"
            },
            {
              "scheme": "https",
              "host": "www.sarhsa.online",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "www.sarhsa.online",
              "pathPrefix": "/councils/join/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#020202",
          "dark": {
            "image": "./assets/images/splash-blank.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#020202"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج سرح إلى الوصول لمكتبة الصور لتختار منها صور ومقاطع إعلاناتك ومنشوراتك وقصصك وصورة ملفك الشخصي والغلاف، ولإرفاقها في المحادثات وطلبات الدعم.",
          "cameraPermission": "يستخدم سرح الكاميرا لالتقاط الصور ومقاطع الفيديو لإعلاناتك ومنشوراتك وقصصك ومحادثاتك، وللظهور في البث المباشر عند بدئك له.",
          "microphonePermission": "يستخدم سرح الميكروفون لتسجيل الرسائل الصوتية في المحادثات، وللتحدث في المجالس والبث المباشر، ولتسجيل صوت مقاطع الفيديو."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم سرح موقعك أثناء استخدام التطبيق فقط لاقتراح مدينتك وتحديد موقع إعلانك على الخريطة ومشاركة موقعك في المحادثات عند طلبك.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0C4132",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-asset",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "يستخدم سرح الميكروفون لتسجيل الرسائل الصوتية في المحادثات، وللتحدث في المجالس والبث المباشر، ولتسجيل صوت مقاطع الفيديو."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc410a8a-09ab-49bb-ba66-53c86471e9aa"
      }
    }
  }
}
