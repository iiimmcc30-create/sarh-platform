{
  "name": "safat",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/start-qr.js",
    "start:qr": "node scripts/start-qr.js",
    "start:railway": "node scripts/start-railway.js",
    "start:usb": "node scripts/start-usb.js",
    "start:lan": "expo start --dev-client --lan --clear",
    "android": "node scripts/run-android-usb.js",
    "android:usb": "node scripts/run-android-usb.js",
    "android:dev": "node scripts/start-usb.js",
    "adb:reverse": "node -e \"require('./scripts/start-usb.js').trySetupUsbReverse().then((u)=>{if(u){console.log('[adb:reverse] OK — API',u.apiUrl,', socket',u.socketUrl);}else{console.log('[adb:reverse] No USB device — connect phone and allow USB debugging');process.exit(1);}}).catch((e)=>{console.error(e.message||e);process.exit(1);})\"",
    "android:rebuild": "node scripts/run-android-usb.js",
    "android:install-all": "node scripts/install-android-all.js",
    "ios": "expo run:ios",
    "web": "node scripts/start-web-railway.js",
    "web:railway": "node scripts/start-web-railway.js",
    "export:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit -p .",
    "test": "jest --config jest.config.js --forceExit",
    "test:cov": "jest --config jest.config.js --coverage --forceExit",
    "test:e2e": "playwright test",
    "sync:icons": "python scripts/generate-circular-branding.py",
    "prebuild": "expo prebuild",
    "eas:dev:android": "eas build --profile development --platform android --non-interactive",
    "eas:dev:ios": "eas build --profile development --platform ios --non-interactive",
    "eas:preview:android": "eas build --profile preview --platform android --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/tajawal": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-trim-video": "^1.0.1",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.27.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-agora": "^4.3.2",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.62.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "eas-cli": "^22.2.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@expo/dom-webview",
        "@expo/log-box"
      ]
    }
  },
  "private": true,
  "overrides": {
    "socket.io-parser": "4.2.7"
  }
}
