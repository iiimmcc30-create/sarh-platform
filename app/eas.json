{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://getsarh.com",
        "EXPO_PUBLIC_SOCKET_URL": "https://getsarh.com",
        "EXPO_PUBLIC_COUNCILS_ENABLED": "true",
        "EXPO_PUBLIC_LIVE_ENABLED": "true",
        "EXPO_PUBLIC_RTC_PROVIDER": "livekit",
        "EXPO_PUBLIC_STORE_DIGITAL_PURCHASES": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://getsarh.com",
        "EXPO_PUBLIC_SOCKET_URL": "https://getsarh.com",
        "EXPO_PUBLIC_COUNCILS_ENABLED": "true",
        "EXPO_PUBLIC_LIVE_ENABLED": "true",
        "EXPO_PUBLIC_RTC_PROVIDER": "livekit",
        "EXPO_PUBLIC_STORE_DIGITAL_PURCHASES": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://getsarh.com",
        "EXPO_PUBLIC_SOCKET_URL": "https://getsarh.com",
        "EXPO_PUBLIC_COUNCILS_ENABLED": "true",
        "EXPO_PUBLIC_LIVE_ENABLED": "true",
        "EXPO_PUBLIC_RTC_PROVIDER": "livekit",
        "EXPO_PUBLIC_STORE_DIGITAL_PURCHASES": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
