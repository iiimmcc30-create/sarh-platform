# Copy to app/android/keystore.properties for local release builds only.
# NEVER commit keystore.properties or the .jks file.
# EAS Build uses credentials stored on Expo — this file is optional for local Gradle builds.
#
# storeFile=../path/to/release.keystore
# storePassword=your-store-password
# keyAlias=your-key-alias
# keyPassword=your-key-password
